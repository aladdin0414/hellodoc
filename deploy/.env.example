# HelloDoc Docker / NAS 部署环境变量示例
# 可复制此文件为 deploy/.env 并按实际环境修改

# Docker Compose 必填项
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/hellodoc
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change_this_database_password
JWT_SECRET=change_this_to_a_secure_jwt_secret_key_at_least_512_bits_long_123456
ADMIN_PASSWORD=change_this_admin_password
SERVER_PORT=8899

# NAS 远程部署配置（执行 deploy.sh 时使用）
NAS_HOST=your_nas_ip
NAS_PORT=22
NAS_USER=your_username
REMOTE_DIR=/volume1/docker/hellodoc
