# HelloDoc 全局环境变量模板文件
# 使用方式：复制本文件为 `.env` 并填写实际参数 (cp .env.example .env)

# =============================================================================
# 数据库配置 (PostgreSQL)
# ⚠️ 注意：启动服务前，请确保已在 PostgreSQL 中手动创建数据库：
#    执行 SQL: CREATE DATABASE hellodoc;
# =============================================================================
# [必填] 数据库连接 URL
DB_URL=jdbc:postgresql://localhost:5432/hellodoc
# [必填] 数据库用户名
DB_USERNAME=postgres
# [必填] 数据库密码 (请修改为实际密码)
DB_PASSWORD=change_this_database_password

# =============================================================================
# 安全与鉴权
# =============================================================================
# [必填] JWT 签名私钥 (推荐长度 >= 512 位 / 64 字节)
JWT_SECRET=change_this_to_a_secure_jwt_secret_key_at_least_512_bits_long_123456
# [必填] 系统初始化时的管理员密码
ADMIN_PASSWORD=change_this_admin_password

# =============================================================================
# AI 大模型服务配置 (可选，如需开启 AI 智能文档/问答助手功能请配置)
# =============================================================================
# [选填] OpenAI 或兼容接口的 API Key
OPENAI_API_KEY=sk-your-openai-api-key
# [选填] API 代理或 Base URL
OPENAI_BASE_URL=https://api.openai.com/v1
# [选填] 使用的模型名称
OPENAI_MODEL=gpt-4o
# [选填] 请求超时时间 (毫秒)
OPENAI_TIMEOUT=60000

# =============================================================================
# 远程 NAS 自动部署配置 (可选，仅在执行 npm run deploy 时使用)
# =============================================================================
NAS_HOST=192.168.1.114
NAS_PORT=2022
NAS_USER=liyc
REMOTE_DIR=/volume1/docker/hellodoc
NAS_SERVER_PORT=8899

# =============================================================================
# 前端 Web 客户端配置 (hellodoc-client 开发代理目标)
# =============================================================================
# [选填] 前端开发服务代理的目标 API 地址 (默认代理到本地 8080)
VITE_API_TARGET=http://localhost:8080
# [选填] 前端开发服务代理的目标 WebSocket 地址 (默认代理到本地 8080)
VITE_WS_TARGET=ws://localhost:8080
