# HelloDoc 全局环境变量模板文件
# 使用方式：复制本文件为 `.env` 并填写实际参数

# =============================================================================
# 数据库配置 (PostgreSQL)
# =============================================================================
DB_URL=jdbc:postgresql://localhost:5432/hellodoc
DB_USERNAME=postgres
DB_PASSWORD=change_this_database_password

# =============================================================================
# 安全与鉴权
# =============================================================================
# JWT 签名私钥 (推荐长度 >= 512 位)
JWT_SECRET=change_this_to_a_secure_jwt_secret_key_at_least_512_bits_long_123456
# 初始管理员密码
ADMIN_PASSWORD=change_this_admin_password

# =============================================================================
# AI 大模型服务配置
# =============================================================================
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT=60000

# =============================================================================
# 远程 NAS 自动部署配置 (可选，在执行 npm run deploy 时使用)
# =============================================================================
NAS_HOST=192.168.1.x
NAS_PORT=22
NAS_USER=your_nas_user
REMOTE_DIR=/volume1/docker/hellodoc
